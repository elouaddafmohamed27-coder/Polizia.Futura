        </div>

        <!-- Timeline Storica -->
        <h2 class="section-title" id="storia" style="margin-top: 70px;">Tappe Storiche</h2>
        <p class="section-subtitle">L'evoluzione dell'istituzione dal 1852 ai giorni nostri</p>

        <div class="timeline">
            <div class="timeline-item">
                <span class="timeline-year">1852</span>
                <h4>Nascita del Corpo delle Guardie di Pubblica Sicurezza</h4>

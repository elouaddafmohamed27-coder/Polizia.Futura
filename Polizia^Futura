        <!-- Il Mio Diario dell'Aspirante -->
        <h2 class="section-title" id="diario" style="margin-top: 70px;">Il Mio Percorso verso la Polizia</h2>
        <p class="section-subtitle">I tuoi progressi e i tuoi appunti vengono salvati automaticamente su questo dispositivo</p>

        <div class="diary-grid">
            <div class="diary-box">
                <h3 style="margin-bottom: 15px; color: var(--light-blue);"><i class="fa-solid fa-list-check"></i> Checklist dell'Aspirante</h3>
                <label class="checklist-item"><input type="checkbox" id="chk1" onchange="salvaDiario()"> Verificare requisiti anagrafici e titolo di studio</label>
                <label class="checklist-item"><input type="checkbox" id="chk2" onchange="salvaDiario()"> Attivare SPID / CIE per l'accesso al portale inPA</label>
                <label class="checklist-item"><input type="checkbox" id="chk3" onchange="salvaDiario()"> Controllare i parametri per le prove di efficienza fisica</label>
                <label class="checklist-item"><input type="checkbox" id="chk4" onchange="salvaDiario()"> Completare almeno 3 simulazioni di quiz</label>
                <label class="checklist-item"><input type="checkbox" id="chk5" onchange="salvaDiario()"> Studiare la Legge 121/1981 e l'ordinamento</label>
            </div>

            <div class="diary-box">
                <h3 style="margin-bottom: 10px; color: var(--light-blue);"><i class="fa-solid fa-pen-to-square"></i> I Miei Appunti & Obiettivi</h3>
                <p style="font-size: 0.85rem; color: var(--gray);">Scrivi qui il reparto in cui sogni di entrare o gli argomenti da ripassare:</p>
                <textarea id="appuntiPersonali" onkeyup="salvaDiario()" placeholder="Es. Obiettivo: entrare nella Polizia Stradale. Da ripassare: diritto costituzionale..."></textarea>
                <small id="statoSalvataggio" style="color: #28a745; display: block; margin-top: 5px;"></small>
            </div>
        </div>

        <!-- TikTok Banner -->
        <div class="social-banner">
            <i class="fa-brands fa-tiktok"></i>
            <h3>Seguici su TikTok: PoliziaDiStato311</h3>
            <p>Pillole sui concorsi, quiz veloci e curiosità direttamente sul profilo <strong>@poliziadistato311</strong>.</p>
            <a href="https://www.tiktok.com/@poliziadistato311" target="_blank">Apri TikTok (@poliziadistato311)</a>
        </div>

    </div>

    <!-- AI Chat Widget -->
    <div class="ai-chat-widget">
        <div class="chat-btn" onclick="toggleChat()" title="Chiedi all'Assistente Virtuale">
            <i class="fa-solid fa-robot"></i>
        </div>
        <div class="chat-box" id="chatBox">
            <div class="chat-header">
                <span><i class="fa-solid fa-robot"></i> Assistente Polizia Futura</span>
                <i class="fa-solid fa-xmark" style="cursor:pointer;" onclick="toggleChat()"></i>
            </div>
            <div class="chat-body" id="chatBody">
                <p><strong>IA:</strong> Ciao! Chiedimi pure informazioni su concorsi, requisiti, Legge 121/81, reparti o come funziona il sito!</p>
            </div>
            <div class="chat-footer">
                <input type="text" id="userInput" placeholder="Scrivi qui la tua domanda..." onkeypress="handleKeyPress(event)">
                <button onclick="sendMessage()"><i class="fa-solid fa-paper-plane"></i></button>
            </div>
        </div>

        <!-- Glossario Interattivo -->
        <h2 class="section-title" id="glossario" style="margin-top: 70px;">Glossario e Sigle Utili</h2>
        <p class="section-subtitle">Tutti i termini e le definizioni fondamentali del mondo della Polizia</p>

        <div class="glossary-grid">
            <div class="glossary-item searchable-item">
                <h4>Questura</h4>
                <p>Ufficio provinciale dell'Amministrazione della Pubblica Sicurezza, diretto dal Questore.</p>
            </div>
            <div class="glossary-item searchable-item">
                <h4>Commissariato</h4>
                <p>Presidio territoriale distaccato della Polizia di Stato che copre specifiche zone o città.</p>
            </div>
            <div class="glossary-item searchable-item">
                <h4>UPGSP</h4>
                <p>Ufficio Prevenzione Generale e Soccorso Pubblico: il reparto che gestisce le Volanti nelle città.</p>
            </div>
            <div class="glossary-item searchable-item">
                <h4>DIGOS</h4>
                <p>Divisione Investigazioni Generali e Operazioni Speciali, presente in ogni Questura.</p>

    <!-- Footer -->
    <footer>
        <p>Contatti e segnalazioni: <a href="mailto:113poliziadistato113@gmail.com">113poliziadistato113@gmail.com</a> | TikTok: <a href="https://www.tiktok.com/@poliziadistato311" target="_blank">@poliziadistato311</a></p>
        <p style="margin-top: 8px;">Fonti istituzionali di riferimento: <a href="https://www.poliziadistato.it/" target="_blank">Polizia di Stato</a> &bull; <a href="https://www.inpa.gov.it/" target="_blank">Portale inPA</a> &bull; <a href="https://www.normattiva.it/" target="_blank">Normattiva</a></p>
        <div class="disclaimer">
            <p><strong>Avviso Legale:</strong> Questo è un progetto informativo indipendente, non affiliato, gestito o autorizzato dalla Polizia di Stato o dal Ministero dell'Interno. Le informazioni pubblicate hanno finalità divulgative e non sostituiscono i bandi, gli avvisi e le comunicazioni ufficiali. In caso di emergenza contattare sempre il Numero Unico 112.</p>
        </div>
    </footer>

    <!-- JavaScript completo -->
    <script>
        // 1. DARK MODE
        function toggleTheme() {
            document.body.classList.toggle('dark-mode');
            const icon = document.getElementById('themeIcon');
            if(document.body.classList.contains('dark-mode')) {
                icon.classList.replace('fa-moon', 'fa-sun');
            } else {
                icon.classList.replace('fa-sun', 'fa-moon');
            }
        }

        // 2. SIMULAZIONE LOGIN CON GOOGLE
        function simulaLogin() {
            const btnText = document.getElementById('loginText');
            if(btnText.innerText === "Accedi") {
                const nome = prompt("Inserisci il tuo nome o email Google per personalizzare il tuo percorso:");
                if(nome && nome.trim() !== "") {
                    btnText.innerText = nome.split('@')[0];
                    alert("Benvenuto su Polizia Futura, " + btnText.innerText + "!");
                }
            } else {
                if(confirm("Vuoi disconnetterti?")) {
                    btnText.innerText = "Accedi";
                }
            }
        }

        // 3. BARRA DI RICERCA ISTANTANEA
        function filtraContenuti() {
            const filtro = document.getElementById('searchInput').value.toLowerCase();
            const elementi = document.querySelectorAll('.searchable-item');
            
            elementi.forEach(el => {
                const testo = el.innerText.toLowerCase();
                el.style.display = testo.includes(filtro) ? 'block' : 'none';
            });
        }

        // 4. WIDGET CURIOSITÀ E GLOSSARIO
        const curiositaList = [
            "Perché si chiamano 'Volanti'? Il termine nacque negli anni '50 con la Squadra Mobile di Milano, dotata di auto velocissime (le Alfa Romeo 1900) pronte a 'volare' sul luogo dell'intervento.",
            "Cosa significa UPGSP? È l'acronimo di Ufficio Prevenzione Generale e Soccorso Pubblico, il cuore operativo delle Questure che coordina le Volanti.",
            "La pantera della Polizia: Fu adottata come simbolo negli anni '50 per rappresentare agilità, scatto, vigilanza e prontezza d'intervento.",
            "Cosa significa DIGOS? Divisione Investigazioni Generali e Operazioni Speciali, reparto presente in ogni Questura.",
            "Il motto della Polizia di Stato è 'Sub lege libertas' (Sotto la legge la libertà), a indicare che la vera libertà si realizza nel rispetto delle regole."
        ];

        function nuvCuriosita() {
            const randomIndex = Math.floor(Math.random() * curiositaList.length);
            document.getElementById('curiositaText').innerText = curiositaList[randomIndex];
        }
        function nuovaCuriosita() { nuvCuriosita(); }
        nuvCuriosita();

        // 5. SIMULATORE QUIZ
        const domandeQuiz = [
            {
                domanda: "Con quale legge la Polizia di Stato è stata smilitarizzata diventando un corpo civile?",
                opzioni: ["Legge 1° aprile 1981, n. 121", "Legge 23 dicembre 1978, n. 833", "Legge 7 agosto 1990, n. 241"],
                corretta: 0,
                spiegazione: "La Legge 121/1981 rappresenta la storica riforma dell'Amministrazione della Pubblica Sicurezza."
            },
            {
                domanda: "Qual è il motto ufficiale della Polizia di Stato?",
                opzioni: ["Nei secoli fedele", "Sub lege libertas", "Nec recisa recedit"],
                corretta: 1,
                spiegazione: "'Sub lege libertas' significa 'Sotto la legge la libertà'."
            },
            {
                domanda: "Chi è l'autorità provinciale di Pubblica Sicurezza a capo della Questura?",
                opzioni: ["Il Prefetto", "Il Questore", "Il Sindaco"],
                corretta: 1,
                spiegazione: "Il Questore dirige, coordina e controlla a livello tecnico-operativo i servizi di ordine e sicurezza pubblica nella provincia."
            },
            {
                domanda: "Quale portale nazionale viene utilizzato per inviare le domande ai concorsi pubblici?",
                opzioni: ["Portale inPA", "Portale INPS", "Portale PagoPA"],
                corretta: 0,
                spiegazione: "Le candidature per i concorsi pubblici si presentano tramite il portale unico del reclutamento inPA."
            },
            {
                domanda: "Quale reparto si occupa della sicurezza delle comunicazioni e del contrasto ai crimini informatici?",
                opzioni: ["Polizia Ferroviaria", "Polizia Postale e per la Sicurezza Cibernetica", "Reparto Mobile"],
                corretta: 1,
                spiegazione: "La Polizia Postale tutela l'integrità delle reti informatiche e contrasta i reati online."
            }
        ];

        let indiceDomanda = 0;
        let punteggio = 0;
        let risposto = false;

        function caricaDomanda() {
            risposto = false;
            document.getElementById('nextBtn').style.display = 'none';
            document.getElementById('quizFeedback').style.display = 'none';
            
            const q = domandeQuiz[indiceDomanda];
            document.getElementById('quizProgress').innerText = `Domanda ${indiceDomanda + 1} di ${domandeQuiz.length}`;
            document.getElementById('questionText').innerText = q.domanda;
            
            const optionsDiv = document.getElementById('optionsContainer');
            optionsDiv.innerHTML = '';
            
            q.opzioni.forEach((opzione, index) => {
                const btn = document.createElement('button');
                btn.className = 'quiz-option';
                btn.innerText = opzione;
                btn.onclick = () => verificaRisposta(index, btn);
                optionsDiv.appendChild(btn);
            });
        }

        function verificaRisposta(scelta, btnCliccato) {
            if(risposto) return;
            risposto = true;
            
            const q = domandeQuiz[indiceDomanda];
            const bottoni = document.querySelectorAll('.quiz-option');
            const feedback = document.getElementById('quizFeedback');
            
            if(scelta === q.corretta) {
                btnCliccato.classList.add('correct');
                punteggio++;
                document.getElementById('quizScore').innerText = `Punteggio: ${punteggio}`;
                feedback.innerHTML = `<strong>Esatto!</strong> ${q.spiegazione}`;
            } else {
                btnCliccato.classList.add('wrong');
                bottoni[q.corretta].classList.add('correct');
                feedback.innerHTML = `<strong>Risposta errata.</strong> ${q.spiegazione}`;
            }
            
            feedback.style.display = 'block';
            document.getElementById('nextBtn').style.display = 'inline-block';
        }

        function prossimaDomanda() {
            indiceDomanda++;
            if(indiceDomanda < domandeQuiz.length) {
                caricaDomanda();
            } else {
                document.getElementById('questionText').innerText = `Simulazione completata! Hai totalizzato ${punteggio} su ${domandeQuiz.length}.`;
                document.getElementById('optionsContainer').innerHTML = `<button class="btn-main" style="border:none; cursor:pointer;" onclick="ricominciaQuiz()">Ricomincia il Quiz</button>`;
                document.getElementById('nextBtn').style.display = 'none';
                document.getElementById('quizFeedback').style.display = 'none';
            }
        }

        function ricominciaQuiz() {
            indiceDomanda = 0;
            punteggio = 0;
            document.getElementById('quizScore').innerText = `Punteggio: 0`;
            caricaDomanda();
        }
        caricaDomanda();

        // 6. DIARIO DELL'ASPIRANTE (LocalStorage)
        function salvaDiario() {
            for(let i=1; i<=5; i++) {
                const chk = document.getElementById('chk' + i);
                if(chk) localStorage.setItem('pf_chk' + i, chk.checked);
            }
            const appunti = document.getElementById('appuntiPersonali');
            if(appunti) localStorage.setItem('pf_appunti', appunti.value);
            
            const stato = document.getElementById('statoSalvataggio');
            if(stato) {
                stato.innerText = "✓ Salvato automaticamente";
                setTimeout(() => { stato.innerText = ""; }, 2000);
            }
        }

        function caricaDiario() {
            for(let i=1; i<=5; i++) {
                const saved = localStorage.getItem('pf_chk' + i);
                const chk = document.getElementById('chk' + i);
                if(saved === 'true' && chk) chk.checked = true;
            }
            const appunti = localStorage.getItem('pf_appunti');
            const textarea = document.getElementById('appuntiPersonali');
            if(appunti && textarea) textarea.value = appunti;
        }
        caricaDiario();

        // 7. ASSISTENTE AI
        function toggleChat() {
            const chatBox = document.getElementById('chatBox');
            if(chatBox) chatBox.style.display = chatBox.style.display === 'block' ? 'none' : 'block';
        }

        function sendMessage() {
            const input = document.getElementById('userInput');
            const chatBody = document.getElementById('chatBody');
            if(!input || input.value.trim() === '') return;

            const userMsg = document.createElement('p');
            userMsg.style.marginTop = "8px";
            userMsg.innerHTML = `<strong>Tu:</strong> ${input.value}`;
            chatBody.appendChild(userMsg);

            const query = input.value.toLowerCase();
            input.value = '';

            setTimeout(() => {
                const aiMsg = document.createElement('p');
                aiMsg.style.marginTop = "8px";
                let risposta = "";

                if(query.includes('concorso') || query.includes('bandi') || query.includes('domanda')) {
                    risposta = "I bandi ufficiali vengono pubblicati sul portale <strong>inPA</strong> e sul sito istituzionale della Polizia di Stato. Controlla sempre i requisiti di età e titolo di studio.";
                } else if(query.includes('altezza') || query.includes('requisiti')) {
                    risposta = "I limiti di altezza sono stati aboliti! Vengono invece valutati i parametri fisici e l'idoneità psico-fisica e attitudinale.";
                } else if(query.includes('121') || query.includes('storia') || query.includes('riforma')) {
                    risposta = "La Legge 1° aprile 1981, n. 121 ha trasformato il Corpo in un'istituzione civile ad ordinamento speciale.";
                } else if(query.includes('tiktok') || query.includes('contatti') || query.includes('email')) {
                    risposta = "Puoi seguirci su TikTok (@poliziadistato311) o scrivere all'email 113poliziadistato113@gmail.com.";
                } else {
                    risposta = "Ottima domanda! Prova a usare il simulatore di Quiz qui sulla pagina oppure scrivici a 113poliziadistato113@gmail.com per proporre un nuovo approfondimento.";
                }

                aiMsg.innerHTML = `<strong>IA:</strong> ${risposta}`;
                chatBody.appendChild(aiMsg);
                chatBody.scrollTop = chatBody.scrollHeight;
            }, 400);
        }

        function handleKeyPress(event) {
            if (event.key === 'Enter') sendMessage();
        }
    </script>
</body>

        <!-- Simulatore di Quiz -->
        <h2 class="section-title" id="quiz" style="margin-top: 70px;">Simulatore di Quiz</h2>
        <p class="section-subtitle">Esercitazione indipendente su Cultura Generale e Ordinamento della Polizia di Stato</p>

        <div class="quiz-container">
            <div class="quiz-header">
                <span id="quizProgress">Domanda 1 di 5</span>
